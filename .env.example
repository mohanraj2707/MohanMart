# ==========================================================================
# MohanMart — Environment Variables Template (.env.example)
# Copy to .env for local overrides (never commit real secrets or .env)
# ==========================================================================

# --- HTTP Server Port (Render injects PORT automatically in production) ---
PORT=8080

# --- Option A: Local H2 Database (Default for Local Development) ---
# Embedded in-memory H2 (PostgreSQL compatibility mode):
JDBC_URL=jdbc:h2:mem:mohanmart;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
# Or file/TCP-backed H2 for persistent local development:
# JDBC_URL=jdbc:h2:tcp://localhost:9092/./data/mohanmart
JDBC_USER=sa
JDBC_PASSWORD=
H2_CONSOLE_ENABLED=true

# --- Option B: Cloud PostgreSQL (Render Managed PostgreSQL) ---
# Render automatically provides DATABASE_URL (postgres://user:pass@host:port/dbname)
# DATABASE_URL=postgresql://mohanmart_user:replace_with_password@localhost:5432/mohanmart
# DB_USERNAME=mohanmart_user
# DB_PASSWORD=replace_with_password

# --- Database Seeding & Initial Admin Configuration ---
SEED_DATABASE=true
ADMIN_EMAIL=admin@mohanmart.com
# Set a strong password in production; hashed with BCrypt (cost=12) at startup
ADMIN_INITIAL_PASSWORD=

# --- AI Marketplace Assistant (O4) ---
# Options: mock (offline deterministic FAQ + live catalog search) | gemini
AI_CHATBOT_PROVIDER=mock
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
