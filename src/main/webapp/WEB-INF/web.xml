<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>MohanMart</display-name>

    <!-- Session Management Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
        <welcome-file>products</welcome-file>
    </welcome-file-list>

    <!-- Error Pages (No Stack Trace Leakage) -->
    <error-page>
        <error-code>400</error-code>
        <location>/WEB-INF/views/error/400.jsp</location>
    </error-page>
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/views/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <!-- Direct Error Route Mappings for Redirects (e.g. AuthFilter /error/403) -->
    <servlet>
        <servlet-name>Error400View</servlet-name>
        <jsp-file>/WEB-INF/views/error/400.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>Error400View</servlet-name>
        <url-pattern>/error/400</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>Error403View</servlet-name>
        <jsp-file>/WEB-INF/views/error/403.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>Error403View</servlet-name>
        <url-pattern>/error/403</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>Error404View</servlet-name>
        <jsp-file>/WEB-INF/views/error/404.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>Error404View</servlet-name>
        <url-pattern>/error/404</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>Error500View</servlet-name>
        <jsp-file>/WEB-INF/views/error/500.jsp</jsp-file>
    </servlet>
    <servlet-mapping>
        <servlet-name>Error500View</servlet-name>
        <url-pattern>/error/500</url-pattern>
    </servlet-mapping>
</web-app>
